using System.Collections;
using TrainworksReloaded.Base;
using TrainworksReloaded.Base.Extensions;
using TrainworksReloaded.Core;
using TrainworksReloaded.Core.Interfaces;
using UnityEngine;

namespace PathogensClan_MT2.Plugin
{
public class CardEffectBalatroConvertCardKeepUpgrades : CardEffectBase, ICardEffectConvertCard
{
	public override bool CanApplyInPreviewMode => false;

	public override PropDescriptions CreateEditorInspectorDescriptions()
	{
		return new PropDescriptions
		{
			[CardEffectFieldNames.ParamCardData.GetFieldName()] = new PropDescription("Destination Card"),
			[RelicEffectFieldNames.ParamInt.GetFieldName()] = new PropDescription("Number of Cards"),
      [CardEffectFieldNames.CopyModifiersFromSource.GetFieldName()] = new PropDescription("Copy Modifiers From Source"),
		};
	}

	public override IEnumerator ApplyEffect(CardEffectState cardEffectState, CardEffectParams cardEffectParams, ICoreGameManagers coreGameManagers, ISystemManagers sysManagers)
	{
		CardManager cardManager = coreGameManagers.GetCardManager();
		SaveManager saveManager = coreGameManagers.GetSaveManager();
		if (!(cardManager == null) && !saveManager.PreviewMode)
		{
			CardState originalCard = cardEffectState.GetParentCardState();
			CardData destinationCard = cardEffectState.GetParamCardData();
			bool loadingDone = false;
			LoadingScreen.AddTask(new LoadAdditionalCards(new List<CardData> { destinationCard }, loadSpawnedCharacters: true, LoadingScreen.DisplayStyle.Spinner, delegate
			{
				loadingDone = true;
			}));
			yield return new WaitUntil(() => loadingDone);
			CardPile targetPile = cardManager.GetCardPileLocation(originalCard);
			if (cardManager.IsCardInHand(originalCard))
			{
				CardManager.DiscardCardParams discardCardParams = new CardManager.DiscardCardParams
				{
					discardCard = originalCard,
					triggeredByCard = true,
					wasPlayed = false,
					overrideDiscardEffect = HandUI.DiscardEffect.Purged
				};
				yield return cardManager.PurgeCardFromHand(discardCardParams, applyOnPurgeRelicEffects: false);
			}
			else
			{
				yield return cardManager.PurgeCard(originalCard, applyOnPurgeRelicEffects: false);
			}
      CardManager.AddCardUpgradingInfo addCardUpgradingInfo = new CardManager.AddCardUpgradingInfo();
			if (cardEffectState.GetCopyModifiersFromSource())
			{
				addCardUpgradingInfo.copyModifiersFromCard = originalCard;
				if (cardEffectParams.selfTarget != null && cardEffectParams.selfTarget.GetSpawnerCard() != null)
				{
					addCardUpgradingInfo.copyModifiersFromCard = cardEffectParams.selfTarget.GetSpawnerCard();
				}
			}
			int paramInt = cardEffectState.GetParamInt();
			for (int i = 0; i < paramInt; i++)
			{
				cardManager.AddNewCard(destinationCard, targetPile, fromRelic: false, permanent: true, addCardUpgradingInfo);
			}
		}
	}

	public override bool CreateAdditionalTooltips(CardEffectData cardEffectData, List<TooltipContent> content, SaveManager saveManager, CardState? sourceCardState = null)
	{
		CardData generatedCardDataForTooltip = GetGeneratedCardDataForTooltip(cardEffectData);
		CardState generatedCardStateForTooltip = GetGeneratedCardStateForTooltip(cardEffectData);
		string title = "CardEffectConvertBattleCard_TooltipTitle".Localize();
		string tooltipContentForGeneratedCard = CardTooltipHelper.GetTooltipContentForGeneratedCard(generatedCardDataForTooltip, generatedCardStateForTooltip, saveManager);
		content.Add(new TooltipContent(title, tooltipContentForGeneratedCard, TooltipDesigner.TooltipDesignType.Default, generatedCardDataForTooltip.GetID()));
		return true;
	}

	public CardData GetGeneratedCardDataForTooltip(ICardEffectDataOrState cardEffect)
	{
		return cardEffect.GetParamCardData();
	}

	public CardState GetGeneratedCardStateForTooltip(ICardEffectDataOrState cardEffect)
	{
		return new CardState(cardEffect.GetParamCardData(), null);
	}
}

}
