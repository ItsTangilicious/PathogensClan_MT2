{
  "$schema": "https://github.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/releases/latest/download/schema.json",
  "cards": [
    {
      "id": "EvolvingResistanceCard",
      "cost": 3,
      "card_type": "spell",
      "names": {
        "english": "Evolving Resistance",
        "chinese": ""
      },
      "descriptions": {
        "english": "Apply [armor] [effect0.status0.power] to friendly units. Add a <b>Herd Resistance</b> to your discard.",
        "chinese": ""
      },
      "rarity": "rare",
      "targets_room": true,
      "targetless": true,
      "class": "@ClassPathogens",
      "card_art": "@EvolvingResistanceCardArt",
      "pools": [ "MegaPool" ],
      "effects": [
        "@EvolvingResistanceArmor", "@EvolvingResistanceUpgrade"
      ],
      "triggers": ["@EvolvingResistanceReserve"],
      "traits": ["@EvolvingResistancePurge"],
      "lore_tooltips": [
        {
          "english": ".",
          "chinese": ""
        }
      ]
    }
  ],
  "traits": [
    {
      "id": "EvolvingResistancePurge",
      "name": "CardTraitSelfPurge"
    }
    ],
  "effects": [
    {
      "id": "EvolvingResistanceArmor",
      "name": "CardEffectAddStatusEffect",
      "target_mode": "room",
      "target_team": "monsters",      
      "param_status_effects": [
        {
          "status": "armor",
          "count": 10
        }
      ]
    },
    {
      "id": "EvolvingResistanceAOEArmor",
      "name": "CardEffectAddStatusEffect",
      "target_mode": "front_in_room",
      "target_team": "monsters",
      "param_status_effects": [
        {
          "status": "armor",
          "count": 5
        }     
      ] 
    },
    {
      "id": "EvolvingResistanceConvert",
      "name": "CardEffectAddRunCard",
      "copy_modifiers_from_source": true,
      "param_int": 1,
      "param_bool": true,
      "param_card_pool": "@EvolvingResistancePoolReserve"
    },
    {
      "id": "EvolvingResistancePurgeMe",
      "name": "@CardEffectPurgeMe"
    },
    {
      "id": "EvolvingResistanceUpgrade",
      "name": "CardEffectAddRunCard",
      "copy_modifiers_from_source": true,
      "param_int": 1,
      "param_bool": true,
      "param_card_pool": "@EvolvingResistancePoolPlay"
    }
  ],
"card_triggers": [
    {
        "id": "EvolvingResistanceReserve",
        "trigger": "on_unplayed_positive",
        "descriptions": {
            "english": "Apply [armor] [effect0.status0.power] to the front friendly unit. Add a <b>Targeted Resistance</b> to your discard and <b>Purge</b> this card."
        },
        "effects": [
            "@EvolvingResistanceAOEArmor", "@EvolvingResistanceConvert", "@EvolvingResistancePurgeMe"
        ]
    }
],
  "card_pools": [
    {
      "id": "EvolvingResistancePoolPlay",
      "cards": [
        "@HerdResistanceCard"
      ]
    },
    {
      "id": "EvolvingResistancePoolReserve",
      "cards": [
        "@TargetedResistanceCard"
      ]
    }
  ],
  "game_objects": [
    {
      "id": "EvolvingResistanceCardArt",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@EvolvingResistanceCardSprite"
        }
      }
    }
  ],
  "sprites": [
    {
      "id": "EvolvingResistanceCardSprite",
      "path": "textures/card_art/EvolvingSpell.png"
    }
  ]
}
