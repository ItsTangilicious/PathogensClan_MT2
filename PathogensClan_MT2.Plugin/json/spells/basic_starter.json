{
  "$schema": "https://github.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/releases/latest/download/schema.json",
  "cards": [
    {
      "id": "VirionStarterCard",
      "cost": 1,
      "card_type": "spell",
      "names": {
        "english": "Virion",
        "chinese": ""
      },
      "descriptions": {
        "english": "Summon 1 Recombinant Virus to the front of this floor.",
        "chinese": ""
      },
      "rarity": "common",
      "targets_room": true,
      "initial_keyboard_target": "front_friendly",
