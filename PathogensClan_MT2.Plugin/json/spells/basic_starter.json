        "@RecombinantVirusUnitCharacter"
      ]
    },
    {
    "id": "VirionRally",
    "name": "CardEffectPlayUnitTrigger",
    "target_mode": "room",
    "target_team": "both",
    "param_trigger": "card_monster_played"
}
  ],

  "game_objects": [
    {
      "id": "VirionStarterCardArt",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@VirionCardSprite"
        }
      }
    }
  ],
  "sprites": [
    {
      "id": "VirionCardSprite",
      "path": "textures/card_art/VirionSpell.png"
    }
  ]
