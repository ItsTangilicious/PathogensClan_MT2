{
  "$schema": "https://github.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/releases/latest/download/schema.json",
  "cards": [
    {
      "id": "ExperimentalCloningChamberCard",
      "cost": 4,
      "card_type": "room",
      "names": {
        "english": "Experimental Cloning Chamber",
        "chinese": "示例房间"
      },
      "descriptions": {
        "english": "Apply [multistrike] [effect0.upgrade.roommodifier0.effect0.status0.power] to firendly units without [multistrike] at the start of combat.",
        "chinese": "示例房间"
      },
      "rarity": "uncommon",
      "targets_room": true,
      "targetless": true,
      "class": "@ClassPathogens",
      "card_art": "@ExperimentalCloningChamberCardArt",
      "effects": [ "@ExperimentalCloningChamberAttach" ],
      "pools": [
        "MegaPool",
        "RoomAndEquipmentMerchant_RoomPool",
        "RoomAndEquipmentDraftPool",
        "RoomAndEquipmentMerchant_RoomAndEquipmentPool",
        "TrainRoomPool"
      ],
      "lore_tooltips": [
        {
          "english": "Example room. RoomAndEquipmentMerchant_RoomPool is required if adding to an event/mutator pool. TrainRoomPool is the pool for the It's Free Real Estate Mutator.",
          "chinese": "RoomAndEquipmentMerchant_RoomPool对应事件/转变器，TrainRoomPool对应“免费房地产”转变器。"
        }
      ]
    }
  ],
  "effects": [
    {
      "id": "ExperimentalCloningChamberAttach",
      "name": "CardEffectAttachTrainRoomAttachment",
      "target_mode": "room",
      "target_team": "monsters",
      "param_upgrade": "@ExperimentalCloningChamberUpgrade"
    },
    {
      "id": "ExperimentalCloningChamberClone",
      "name": "CardEffectAddStatusEffect",
      "target_mode": "room",
      "target_team": "monsters",
      "target_mode_status_effects_excluded_filter": ["multistrike"],
      "param_status_effects": [
        {
          "status": "multistrike",
          "count": 1
        }
      ]
    }
  ],
  "upgrades": [
    {
      "id": "ExperimentalCloningChamberUpgrade",
      "icon": "@ExperimentalCloningChamberIcon",
      "room_modifier_upgrades": [ "@ExperimentalCloningChamberPreCombat" ]
    }
  ],
  "room_modifiers": [
    {
      "id": "ExperimentalCloningChamberPreCombat",
      "name": "RoomStateAddEffectPreCombatModifier",
      "param_effects": [
      "@ExperimentalCloningChamberClone"
      ]
    }
  ],
  "game_objects": [
    {
      "id": "ExperimentalCloningChamberCardArt",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@ExperimentalCloningChamberCardSprite"
        }
      }
    }
  ],
  "sprites": [
    {
      "id": "ExperimentalCloningChamberCardSprite",
      "path": "textures/card_art/ColiformCard.png"
    },
    {
      "id": "ExperimentalCloningChamberIcon",
      "path": "textures/icons/ExperimentalCloningChamberIcon.png"
    }
  ]
}
