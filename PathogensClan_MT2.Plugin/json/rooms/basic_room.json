{
  "$schema": "https://github.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/releases/latest/download/schema.json",
  "cards": [
    {
      "id": "CyanoBloomCard",
      "cost": 2,
      "card_type": "room",
      "names": {
        "english": "Cyano Bloom",
        "chinese": "示例房间"
      },
      "descriptions": {
        "english": "+[effect0.upgrade.roommodifier0.power][capacity]. Grant friendly units +[effect0.upgrade.bonusdamage][attack] and +[effect0.upgrade.bonushp][health]",
        "chinese": "示例房间"
      },
      "rarity": "uncommon",
      "targets_room": true,
      "targetless": true,
      "class": "@ClassPathogens",
      "card_art": "@CyanoBloomCardArt",
      "effects": [ "@CyanoBloomAttach" ],
      "pools": [
        "MegaPool",
        "RoomAndEquipmentMerchant_RoomPool",
        "RoomAndEquipmentDraftPool",
        "RoomAndEquipmentMerchant_RoomAndEquipmentPool",
        "TrainRoomPool"
      ],
      "lore_tooltips": [
        {
          "english": "Example room. RoomAndEquipmentMerchant_RoomPool is required if adding to an event/mutator pool. TrainRoomPool is the pool for the It's Free Real Estate Mutator.",
          "chinese": "RoomAndEquipmentMerchant_RoomPool对应事件/转变器，TrainRoomPool对应“免费房地产”转变器。"
        }
      ]
    }
  ],
  "effects": [
    {
      "id": "CyanoBloomAttach",
      "name": "CardEffectAttachTrainRoomAttachment",
      "target_mode": "room",
      "target_team": "monsters",
      "param_upgrade": "@CyanoBloomUpgrade"
    },
    {
      "id": "CyanoBloomGrow",
      "name": "CardEffectAdjustRoomCapacity",
      "param_int": 1
    },
    {
      "id": "CyanoBloomSpawn",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "target_team": "monsters",      
      "param_bool": true,
      "param_character_pool": [
        "@RecombinantVirusUnitCharacter"
      ]
    }
  ],
  "upgrades": [
    {
      "id": "CyanoBloomUpgrade",
      "room_modifier_upgrades": [
      "@CyanoBloomResolve"
      ]
      "icon": "@CyanoBloomIcon",
      "room_modifier_upgrades": [ "@CyanoBloomAdjustCapacity" ]
    }
  ],
  "room_modifiers": [
    {
      "id": "CyanoBloomResolve",
      "name": "RoomStateAddEffectPostCombatModifier"
      "param_effects": [
      "@CyanoBloomGrow", "@CyanoBloomSpawn"
      ]
    }
  ],
  "game_objects": [
    {
      "id": "CyanoBloomCardArt",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@CyanoBloomCardSprite"
        }
      }
    }
  ],
  "sprites": [
    {
      "id": "CyanoBloomCardSprite",
      "path": "textures/card_art/RoomForGrowthSpell.png"
    },
    {
      "id": "CyanoBloomIcon",
      "path": "textures/icons/CyanoBloomIcon.png"
    }
  ]
}
