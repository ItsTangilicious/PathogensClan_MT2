{
  "$schema": "https://github.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/releases/latest/download/schema.json",
  "cards": [
    {
      "id": "SpawnCryogenicStorage",
      "names": {
        "english": "Cryogenic Storage",
        "chinese": ""
      },
      "card_art": "@CryogenicStorageUnitCardArt",
      "cost": 1,
      "card_type": "monster",
      "rarity": "uncommon",
      "class": "@ClassPathogens",
      "targets_room": true,
      "targetless": false,
      "pools": ["MegaPool" ],
      "effects": [ "@SpawnCryogenicStorageNonBannerUnit" ],
      "traits": ["@CryogenicChamberFrozen"],
      "lore_tooltips": [
        {
          "english": "This is an example banner unit with a trigger generated by the Mod Template.",
          "chinese": ""
        }
      ]
    },
  ],
  "characters": [
    {
      "id": "CryogenicStorageUnitCharacter",
      "names": {
        "english": "Cryogenic Storage",
        "chinese": ""
      },
      "character_art": "@CryogenicStorageUnitCharacterArt",
      "size": 1,
      "health": 5,
      "attack_damage": 0,
      "subtypes": [ "@PathogenSub_Instrument" ],
      "triggers": [ "@CryogenicStorageUnitReserve", "@CryogenicStorageUnitSummon" ]
    }
  ],
  "character_triggers": [
    {
      "id": "CryogenicStorageUnitReserve",
      "trigger": "on_unplayed_positive",
      "descriptions": {
        "english": "Gain [stygianblessing] [effect0.upgrade.status0.power].",
        "chinese": ""
      },
      "effects": [ "@CryogenicStorageReserveShard" ]
    },
    {
      "id": "CryogenicStorageUnitSummon"
      "trigger": "on_spawn",
      "descriptions": {
        "english": "Return a random consumed spell to your hand for each [stygianblessing].",
        "chinese": ""
      },
      "effects": [ "@CryogenicStorageReturnConsume" ]
    }
  ],
  "traits": [
  {
  "id": "CryogenicChamberFrozen",
    "name": "CardTraitFreeze"
  }
  ],
  "upgrades": [
    {
      "id": "CryogenicStorageUpgrade",
      "status_effect_upgrades": [
        {
          "status": "stygian_blessing",
          "count": 1
        }
      ]
    }
  ],
  "effects": [
    {
      "id": "SpawnCryogenicStorageNonBannerUnit",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "param_character": "@CryogenicStorageUnitCharacter"
    },
    {
      "id": "CryogenicStorageReserveShard",
      "name": "CardEffectAddUpgradeToCurrentCard",
      "target_mode": "self",
      "param_upgrade": "@CryogenicStorageUpgrade"
    },
    {
      "id": "CryogenicStorageReturnConsume",
      "name": "@CardEffectRecursionPerBlessing",
      "target_mode": "exhaust_pile".
      "target_card_type": "spell",
      "param_int": 1
