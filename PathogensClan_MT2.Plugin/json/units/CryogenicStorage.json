  ],
  "game_objects": [
    {
      "id": "CryogenicStorageUnitCardArt",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@CryogenicStorageUnitCardSprite"
        }
      }
    },
    {
      "id": "CryogenicStorageUnitCharacterArt",
      "type": "character_art",
      "extensions": {
        "character_art": {
          "sprite": "@CryogenicStorageUnitCharacterSprite"
        }
      }
    }
  ],
  "sprites": [
    {
      "id": "CryogenicStorageUnitCardSprite",
      "path": "textures/card_art/CryogenicStorageCard.png"
    },
    {
      "id": "CryogenicStorageUnitCharacterSprite",
      "path": "textures/character_art/CryogenicStorageCharacter.png"
    }
  ]
