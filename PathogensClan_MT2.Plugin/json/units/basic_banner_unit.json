{
  "$schema": "https://github.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/releases/latest/download/schema.json",
  "cards": [
    {
      "id": "SpawnAntigenMimic",
      "names": {
        "english": "Antigen Mimic",
        "chinese": ""
      },
      "card_art": "@BasicBannerUnitCardArt",
      "cost": 1,
      "card_type": "monster",
      "rarity": "uncommon",
      "class": "@ClassPathogens",
      "targets_room": true,
      "targetless": false,
      "pools": [ "UnitsAllBanner", "@UnitsPathogensClanBanner" ],
      "effects": [ "@SpawnAntigenMimicBannerUnit" ],
      "lore_tooltips": [
        {
          "english": "This is an example banner unit with a trigger generated by the Mod Template.",
          "chinese": ""
        }
      ]
    },
    {
      "id": "AntigenMimicEat",
      "names": {
        "english": "Phagocytosis"
    },
    "descriptions": {
      "english": "Apply +[trait0.power][health] to friendly units for each Pathogen unit in your deck.<br>Gain [effect2.powerabs][PathogensClan_MT2.Plugin_Toxicity]."
    },
    "is_an_ability": true,
    "cooldown": 2,
    "initial_cooldown": 0,
    "targetless": false,
    "targets_room": true,
    "card_type": "spell",
    "effects": [ "@AntigenMimicAbilityEat", "@AntigenMimicGainHealth", "@AntigenMimicGainToxicity"],
    "traits": ["@AntigenMimicScalingHealth"]
  }
  ],
  "characters": [
    {
      "id": "AntigenMimicUnitCharacter",
      "names": {
        "english": "Antigen Mimic",
        "chinese": ""
      },
      "character_art": "@BasicBannerUnitCharacterArt",
      "size": 2,
      "health": 30,
      "attack_damage": 15,
      "ability": "@AntigenMimicEat",
      "subtypes": [ "SubtypesData_BannerUnit", "@PathogenSub_Pathogen" ],
      "triggers": [ "@AntigenMimicUnitRally" ]
    }
  ],
  "character_triggers": [
    {
      "id": "AntigenMimicUnitRally",
      "trigger": "card_monster_played",
      "descriptions": {
        "english": "Apply [regen] [effect0.status0.power] to friendly units.",
        "chinese": ""
      },
      "effects": [ "@AntigenMimicRallyRegen" ]
    }
  ],
  "effects": [
    {
      "id": "SpawnAntigenMimicBannerUnit",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "param_character": "@AntigenMimicUnitCharacter"
    },
    {
      "id": "AntigenMimicRallyRegen",
      "name": "CardEffectAddStatusEffect",
      "target_mode": "room",
      "target_team": "monsters",
      "param_status_effects": [
        {
          "status": "regen",
          "count": 1
        }
      ]
    },
    {
      "id": "AntigenMimicAbilityEat",
      "name": "CardEffectSacrifice",
      "target_mode": "drop_target_character",
      "target_team": "monsters",
      "should_fail_to_cast_if_test_fails": true
    },
    {
      "id": "AntigenMimicGainHealth",
      "name": "CardEffectAddCardUpgradeToUnits",
      "target_mode": "room",
      "target_team":"monsters",
      "param_upgrade": "@MimicFiveScaling",
      "param_int_3": 0
    },
     {
      "id": "AntigenMimicGainToxicity",
      "name": "@CardEffectRewardToxicity",
      "target_mode": "self",
      "param_int": 1,
      "should_test": true,
      "should_fail_to_cast_if_test_fails": true
    }
  ],
  "traits": [
    {
        "id": "AntigenMimicScalingHealth",
        "name": "CardTraitScalingUpgradeUnitHealth",
        "param_tracked_value": "subtype_in_deck",
        "param_subtype": "@PathogenSub_Pathogen",
        "param_int": 4
    }
  ],
  "upgrades": [
    {
      "id":"MimicFiveScaling",
      "bonus_damage": 0,
      "upgrade_will_be_scaled_by_non_magic_power_trait": true
    }
  ],
  "game_objects": [
    {
      "id": "BasicBannerUnitCardArt",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@BasicBannerUnitCardSprite"
        }
      }
    },
    {
      "id": "BasicBannerUnitCharacterArt",
      "type": "character_art",
      "extensions": {
        "character_art": {
          "sprite": "@BasicBannerUnitCharacterSprite"
        }
      }
    }
  ],
  "sprites": [
    {
      "id": "BasicBannerUnitCardSprite",
      "path": "textures/card_art/AntigenMimicCard.png"
    },
    {
      "id": "BasicBannerUnitCharacterSprite",
      "path": "textures/character_art/AntigenMimicCharacter.png"
    }
  ]
}
