{
  "$schema": "https://github.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/releases/latest/download/schema.json",
  "cards": [
    {
      "id": "SpawnAntigenMimic",
      "names": {
        "english": "Antigen Mimic",
        "chinese": ""
      },
      "card_art": "@BasicBannerUnitCardArt",
      "cost": 2,
      "card_type": "monster",
      "rarity": "uncommon",
      "class": "@ClassPathogens",
      "targets_room": true,
      "targetless": false,
      "pools": [ "UnitsAllBanner", 
        //"@UnitsPathogensClanBanner" 
      ],
      "effects": [ "@SpawnAntigenMimicBannerUnit" ],
      "lore_tooltips": [
        {
          "english": "This is an example banner unit with a trigger generated by the Mod Template.",
          "chinese": ""
        }
      ]
    }
  ],
  "characters": [
    {
      "id": "AntigenMimicUnitCharacter",
      "names": {
        "english": "Pathogens Banner Unit",
        "chinese": ""
      },
      "character_art": "@BasicBannerUnitCharacterArt",
      "size": 2,
      "health": 30,
      "attack_damage": 15,
      "subtypes": [ "SubtypesData_BannerUnit", "@PathogenSub_Pathogen" ],
      "triggers": [ "@AntigenMimicUnitRally" ]
    }
  ],
  "character_triggers": [
    {
      "id": "AntigenMimicUnitRally",
      "trigger": "card_monster_played",
      "descriptions": {
        "english": "Apply [regen] [effect0.status0.power] to friendly units.",
        "chinese": ""
      },
      "effects": [ "@AntigenMimicRallyRegen" ]
    }
  ],
  "effects": [
    {
      "id": "SpawnAntigenMimic",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "param_character": "@AntigenMimic"
    },
    {
      "id": "AntigenMimicRallyRegen",
      "name": "CardEffectAddStatusEffect",
      "target_mode": "room",
      "target_team": "monsters",
      "param_status_effects": [
        {
          "status": "regen",
          "count": 2
        }
      ]
    }
  ],
  "game_objects": [
    {
      "id": "BasicBannerUnitCardArt",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@BasicBannerUnitCardSprite"
        }
      }
    },
    {
      "id": "BasicBannerUnitCharacterArt",
      "type": "character_art",
      "extensions": {
        "character_art": {
          "sprite": "@BasicBannerUnitCharacterSprite"
        }
      }
    }
  ],
  "sprites": [
    {
      "id": "BasicBannerUnitCardSprite",
      "path": "textures/card_art/BasicBannerUnit.png"
    },
    {
      "id": "BasicBannerUnitCharacterSprite",
      "path": "textures/character_art/BasicBannerUnit.png"
    }
  ]
}
