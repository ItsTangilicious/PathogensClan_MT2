      "target_mode": "room",
      "target_team": "heroes",
      "param_status_effects": [
            {
            "status": "@contagion",
            "count": 10
            }
        ]
    }
  ],
  "game_objects": [
    {
      "id": "AsymptomaticCarrierUnitCardArt",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@AsymptomaticCarrierUnitCardSprite"
        }
      }
    },
    {
      "id": "AsymptomaticCarrierUnitCharacterArt",
      "type": "character_art",
      "extensions": {
        "character_art": {
          "sprite": "@AsymptomaticCarrierUnitCharacterSprite"
        }
      }
    }
  ],
  "sprites": [
    {
      "id": "AsymptomaticCarrierUnitCardSprite",
      "path": "textures/card_art/AsymptomaticCard.png"
    },
    {
      "id": "AsymptomaticCarrierUnitCharacterSprite",
