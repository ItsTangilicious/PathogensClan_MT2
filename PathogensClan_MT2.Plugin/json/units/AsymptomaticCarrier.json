        "english": "Apply [PathogensClan_MT2.Plugin_contagion] [effect0.status0.power] to enemy units.",
        "chinese": ""
      },
      "effects": [ "@AsymptomaticCarrierRallyContagion" ]
    }
  ],
  "effects": [
    {
      "id": "SpawnAsymptomaticCarrierUnit",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "param_character": "@AsymptomaticCarrierUnitCharacter"
    },
    {
      "id": "AsymptomaticCarrierRallyContagion",
