{
  "$schema": "https://github.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/releases/latest/download/schema.json",
  "cards": [
    {
      "id": "SpawnAsymptomaticCarrier",
      "names": {
        "english": "Asymptomatic Carrier",
        "chinese": ""
      },
      "card_art": "@AsymptomaticCarrierUnitCardArt",
