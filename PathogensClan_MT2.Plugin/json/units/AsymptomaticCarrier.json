        {
          "english": "This is an example banner unit with a trigger generated by the Mod Template.",
          "chinese": ""
        }
      ]
    }
  ],
  "characters": [
    {
      "id": "AsymptomaticCarrierUnitCharacter",
      "names": {
        "english": "Asymptomatic Carrier",
        "chinese": ""
      },
      "character_art": "@AsymptomaticCarrierUnitCharacterArt",
      "size": 3,
      "health": 40,
      "attack_damage": 15,
      "subtypes": [ "SubtypesData_BannerUnit", "@PathogenSub_Host" ],
      "triggers": [ "@AsymptomaticCarrierRally" ]
    }
  ],
    "character_triggers": [
    {
      "id": "AsymptomaticCarrierRally",
      "trigger": "card_monster_played",
