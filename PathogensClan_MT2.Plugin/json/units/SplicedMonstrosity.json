{
  "$schema": "https://github.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/releases/latest/download/schema.json",
  "cards": [
    {
      "id": "SpawnSplicedMonstrosity",
      "names": {
        "english": "Spliced Monstrosity",
        "chinese": ""
      },
      "card_art": "@SplicedMonstrosityUnitCardArt",
      "cost": 1,
      "card_type": "monster",
      "rarity": "uncommon",
      "class": "@ClassPathogens",
      "targets_room": true,
      "targetless": false,
      "pools": [ "UnitsAllBanner", "@UnitsPathogensClanBanner" ],
      "effects": [ "@SpawnSplicedMonstrosityBannerUnit" ],
      "lore_tooltips": [
        {
          "english": "This is an example banner unit with a trigger generated by the Mod Template.",
          "chinese": ""
        }
      ]
    },
    {
      "id": "SplicedMonstrosityShed",
      "names": {
        "english": "Ectodomain Fusion"
    },
    "descriptions": {
      "english": "If you have [effect0.powerabs][PathogensClan_MT2.Plugin_Toxicity], spend it to apply +[effect1.status0.power] [spikes] per [stygianblessing] to friendly units."
    },
    "is_an_ability": true,
    "cooldown": 1,
    "initial_cooldown": 0,
    "targetless": true,
    "targets_room": false,
    "card_type": "spell",
    "effects": [ "@SplicedMonstrositySpendToxicity", "@SplicedMonstrosityAbilityShed"]    
  }
  ],
  "characters": [
    {
      "id": "SplicedMonstrosityUnitCharacter",
      "names": {
        "english": "Spliced Monstrosity",
        "chinese": ""
      },
      "character_art": "@SplicedMonstrosityUnitCharacterArt",
      "size": 2,
      "health": 25,
      "attack_damage": 10,
      "ability": "@SplicedMonstrosityShed",
      "subtypes": [ "SubtypesData_BannerUnit", "@PathogenSub_Pathogen" ],
      "triggers": [ "@SplicedMonstrosityUnitRally" ]
    }
  ],
  "character_triggers": [
    {
      "id": "SplicedMonstrosityUnitRally",
      "trigger": "card_monster_played",
      "descriptions": {
        "english": "Gain [stygianblessing] [effect0.status0.power].",
        "chinese": ""
      },
      "effects": [ "@SplicedMonstrosityRallyShard" ]
    }
  ],
  "effects": [
    {
      "id": "SpawnSplicedMonstrosityBannerUnit",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "param_character": "@SplicedMonstrosityUnitCharacter"
    },
    {
      "id": "SplicedMonstrosityRallyShard",
      "name": "CardEffectAddStatusEffect",
      "target_mode": "self",
      "target_team": "monsters",
      "param_status_effects": [
        {
          "status": "stygian_blessing",
          "count": 1
        }
      ]
    },
    {
      "id": "SplicedMonstrositySpendToxicity",
      "name": "@CardEffectRewardToxicity",
      "target_mode": "self",
      "param_int": -1,
      "should_test": true,
      "should_fail_to_cast_if_test_fails": true
    },
    {
      "id": "SplicedMonstrosityAbilityShed",
      "name": "CardEffectAddStatusEffect",
      "target_mode": "room",
      "target_team": "monsters",
      "param_int": 100,
      "use_status_effect_multiplier": true,
      "status_effect_multiplier": "stygian_blessing",
      "param_status_effects": [
        {
        "status": "spikes",
        "count": 2
        }
      ]
    }  
  ],
  "game_objects": [
    {
      "id": "SplicedMonstrosityUnitCardArt",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@SplicedMonstrosityUnitCardSprite"
        }
      }
    },
    {
      "id": "SplicedMonstrosityUnitCharacterArt",
      "type": "character_art",
      "extensions": {
        "character_art": {
          "sprite": "@SplicedMonstrosityUnitCharacterSprite"
        }
      }
    }
  ],
  "sprites": [
    {
      "id": "SplicedMonstrosityUnitCardSprite",
      "path": "textures/card_art/SplicedMonstrosityCard.png"
    },
    {
      "id": "SplicedMonstrosityUnitCharacterSprite",
      "path": "textures/character_art/SplicedMonstrosityCharacter.png"
    }
  ]
}
