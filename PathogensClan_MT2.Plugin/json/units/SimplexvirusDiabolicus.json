{
  "$schema": "https://github.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/releases/latest/download/schema.json",
  "cards": [
    {
      "id": "SpawnSimplexVirus",
      "names": {
        "english": "Simplexvirus Diabolicus",
        "chinese": ""
      },
      "card_art": "@SimplexVirusUnitCardArt",
      "cost": 1,
      "card_type": "monster",
      "rarity": "uncommon",
      "class": "@ClassPathogens",
      "targets_room": true,
      "targetless": false,
      "pools": [ "UnitsAllBanner", "@UnitsPathogensClanBanner" ],
      "effects": [ "@SpawnSimplexVirusUnit" ],
      "lore_tooltips": [
        {
          "english": "This is an example banner unit with a trigger generated by the Mod Template.",
          "chinese": ""
        }
      ]
    }
  ],
  "characters": [
    {
      "id": "SimplexVirusUnitCharacter",
      "names": {
        "english": "Simplexvirus Diabolicus",
        "chinese": ""
      },
      "character_art": "@SimplexVirusUnitCharacterArt",
      "size": 2,
      "health": 35,
      "attack_damage": 5,
      "subtypes": [ "SubtypesData_BannerUnit", "@PathogenSub_Pathogen" ],
      "triggers": [ "@SimplexVirusResolve" ]
    }
  ],
    "character_triggers": [
    {
      "id": "SimplexVirusResolve",
      "trigger": "post_combat",
      "descriptions": {
        "english": "Summon 1 Recombinant Virus.",
        "chinese": ""
      },
      "effects": [ "@SimplexVirusResolveSpawn" ]
    }
  ],
  "effects": [
    {
      "id": "SpawnSimplexVirusUnit",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "param_character": "@SimplexVirusUnitCharacter"
    },
    {
      "id": "SimplexVirusResolveSpawn",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "target_team": "monsters",
      "param_bool": true,
      "param_character_pool": [
        "@RecombinantVirusUnitCharacter"
      ]
    }
  ],
  "game_objects": [
    {
      "id": "SimplexVirusCardArt",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@SimplexVirusUnitCardSprite"
        }
      }
    },
    {
      "id": "SimplexVirusUnitCharacterArt",
      "type": "character_art",
      "extensions": {
        "character_art": {
          "sprite": "@SimplexVirusUnitCharacterSprite"
        }
      }
    }
  ],
  "sprites": [
    {
      "id": "SimplexVirusUnitCardSprite",
      "path": "textures/card_art/SimplexvirusCard.png"
    },
    {
      "id": "SimplexVirusUnitCharacterSprite",
      "path": "textures/character_art/SimplexvirusCharacter.png"
    }
  ]
}
