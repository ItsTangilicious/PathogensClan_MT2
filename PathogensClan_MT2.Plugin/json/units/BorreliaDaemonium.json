      "card_type": "monster",
      "rarity": "rare",
      "class": "@ClassPathogens",
      "targets_room": true,
      "targetless": false,
      "pools": [ "UnitsAllBanner", "@UnitsPathogensClanBanner" ],
      "effects": [ "@SpawnBorreliaDaemoniumUnit" ],
      "lore_tooltips": [
        {
          "english": "This is an example banner unit with a trigger generated by the Mod Template.",
          "chinese": ""
        }
      ]
    }
  ],
  "characters": [
    {
      "id": "BorreliaDaemoniumUnitCharacter",
      "names": {
        "english": "Borrelia Daemonium",
        "chinese": ""
      },
      "character_art": "@BorreliaDaemoniumUnitCharacterArt",
      "size": 1,
      "health": 15,
      "attack_damage": 15,
      "subtypes": [ "SubtypesData_BannerUnit", "@PathogenSub_Pathogen" ],
      "triggers": [ "@BorreliaDaemoniumSummon" ]
    }
  ],
    "character_triggers": [
    {
      "id": "BorreliaDaemoniumSummon",
      "trigger": "on_spawn",
      "descriptions": {
        "english": "Add a copy of this card to your discard pile. Draw a unit.",
        "chinese": ""
      },
      "effects": [ "@BorreliaDaemoniumSummonCopy", "@BorreliaDaemoniumSummonDraw" ]
    }
  ],
  "effects": [
    {
      "id": "SpawnBorreliaDaemoniumUnit",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "param_character": "@BorreliaDaemoniumUnitCharacter"
    },
    {
      "id": "BorreliaDaemoniumSummonCopy",
      "name": "CardEffectAddUpgradedCopy",
      "param_int": 1,
      "param_int_2": 1,
      "copy_modifiers_from_source": true,
      "param_card_pool": "@BorreliaPool"
    },
    {
        "id": "BorreliaDaemoniumSummonDraw",
        "name": "CardEffectDrawType",        
        "target_card_type": "monster",
        "param_int": 1
    }
  ],
  "card_pools": [
    {
      "id": "BorreliaPool",
      "cards": [
        "@SpawnBorreliaDaemonium"
      ]
    }
  ],
  "game_objects": [
    {
      "id": "BorreliaDaemoniumUnitCardArt",
      "type": "card_art",
      "extensions": {
