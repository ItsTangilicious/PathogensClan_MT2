{
  "$schema": "https://github.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/releases/latest/download/schema.json",
  "cards": [
    {
      "id": "SpawnPlaguebringer",
      "names": {
        "english": "Plaguebringer",
        "chinese": ""
      },
      "card_art": "@PlaguebringerUnitCardArt",
      "cost": 1,
      "card_type": "monster",
      "rarity": "rare",
      "class": "@ClassPathogens",
      "targets_room": true,
      "targetless": false,
      "pools": [ "UnitsAllBanner", "@UnitsPathogensClanBanner" ],
      "effects": [ "@SpawnPlaguebringerUnit" ],
      "lore_tooltips": [
        {
          "english": "This is an example banner unit with a trigger generated by the Mod Template.",
          "chinese": ""
        }
      ]
    }
  ],
  "characters": [
    {
      "id": "PlaguebringerUnitCharacter",
      "names": {
        "english": "Plaguebringer",
        "chinese": ""
      },
      "character_art": "@PlaguebringerUnitCharacterArt",
       "starting_status_effects": [
        {
          "status": "sweep",
          "count": 1
        }
      ],
      "size": 2,
      "health": 25,
      "attack_damage": 1,
      "subtypes": [ "SubtypesData_BannerUnit", "@PathogenSub_Host" ],
      "triggers": [ "@PlaguebringerStrike", "@PlaguebringerResolve" ]
    }
  ],
    "character_triggers": [
    {
      "id": "PlaguebringerStrike",
      "trigger": "on_attacking",
      "descriptions": {
        "english": "Apply [PathogensClan_MT2.Plugin_contagion] [effect0.status0.power].",
        "chinese": ""
      },
      "effects": [ "@PlaguebringerStrikeContagion" ]
    },
        {
      "id": "PlaguebringerResolve",
      "trigger": "post_combat",
      "descriptions": {
        "english": "Double [PathogensClan_MT2.Plugin_contagion] on enemy units.",
        "chinese": ""
      },
      "effects": [ "@PlaguebringerResolveContagion" ]
    }
  ],
  "effects": [
    {
      "id": "SpawnPlaguebringerUnit",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "param_character": "@PlaguebringerUnitCharacter"
    },
    {
      "id": "PlaguebringerResolveContagion",
      "name": "CardEffectAddStatusEffect",
      "target_mode": "last_attacked_character",
      "target_team": "heroes",
      "param_status_effects": [
        {
          "status": "@contagion",
          "count": 8
        }
      ]
    },
    {
        "id": "PlaguebringerStrikeContagion",
        "name": "CardEffectMultiplyStatusEffect",
        "target_mode": "room",
        "target_team": "heroes",
        "param_status_effects": [
            {
            "status": "@contagion",
            "count": 2
            }
        ]
    }
  ],
  "game_objects": [
    {
      "id": "PlaguebringerUnitCardArt",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@PlaguebringerUnitCardSprite"
        }
      }
    },
    {
      "id": "PlaguebringerUnitCharacterArt",
      "type": "character_art",
      "extensions": {
        "character_art": {
          "sprite": "@PlaguebringerUnitCharacterSprite"
        }
      }
    }
  ],
  "sprites": [
    {
      "id": "PlaguebringerUnitCardSprite",
      "path": "textures/card_art/PlaguebringerCard.png"
    },
    {
      "id": "PlaguebringerUnitCharacterSprite",
      "path": "textures/character_art/PlaguebringerCharacter.png"
    }
  ]
}
