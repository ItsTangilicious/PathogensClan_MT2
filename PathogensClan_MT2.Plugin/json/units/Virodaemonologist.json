{
  "$schema": "https://github.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/releases/latest/download/schema.json",
  "cards": [
    {
      "id": "SpawnVirodaemonologist",
      "names": {
        "english": "Virodaemonologist",
        "chinese": ""
      },
      "card_art": "@VirodaemonologistUnitCardArt",
      "cost": 1,
      "card_type": "monster",
      "rarity": "uncommon",
      "class": "@ClassPathogens",
      "targets_room": true,
      "targetless": false,
      "pools": [ "UnitsAllBanner", "@UnitsPathogensClanBanner" ],
      "effects": [ "@SpawnVirodaemonologistBannerUnit" ],
      "lore_tooltips": [
        {
          "english": "This is an example banner unit with a trigger generated by the Mod Template.",
          "chinese": ""
        }
      ]
    },
    {
      "id": "VirodaemonologistBreakthrough",
      "names": {
        "english": "Toxicological Breakthrough"
    },
    "descriptions": {
      "english": "If you have [effect0.powerabs][PathogensClan_MT2.Plugin_Toxicity], spend it to apply +[effect1.upgrade.bonusdamage][attack] and +[effect1.upgrade.bonushp][health] permanently"
    },
    "is_an_ability": true,
    "cooldown": 1,
    "initial_cooldown": 0,
    "targetless": true,
    "targets_room": false,
    "card_type": "spell",
    "effects": [ "@VirodaemonologistSpendToxicity", "@VirodaemonologistPermaStats"]    
  }
  ],
  "characters": [
    {
      "id": "VirodaemonologistUnitCharacter",
      "names": {
        "english": "Virodaemonologist",
        "chinese": ""
      },
      "character_art": "@VirodaemonologistUnitCharacterArt",
      "size": 2,
      "health": 10,
      "attack_damage": 30,
      "ability": "@VirodaemonologistBreakthrough",
      "subtypes": [ "SubtypesData_BannerUnit", "@PathogenSub_Host" ],
      "triggers": [ "@VirodaemonologistUnitSlay" ]
    }
  ],
  "character_triggers": [
    {
      "id": "VirodaemonologistUnitSlay",
      "trigger": "on_kill",
      "descriptions": {
        "english": "Gain [effect0.powerabs][PathogensClan_MT2.Plugin_Toxicity].",
        "chinese": ""
      },
      "effects": [ "@VirodaemonologistSlayToxicity" ]
    }
  ],
  "effects": [
    {
      "id": "SpawnVirodaemonologistBannerUnit",
      "name": "CardEffectSpawnMonster",
      "target_mode": "room",
      "param_character": "@VirodaemonologistUnitCharacter"
    },
    {
      "id": "VirodaemonologistSlayToxicity",      
      "name": "@CardEffectRewardToxicity",
      "target_mode": "self",
      "param_int": 1,
      "should_test": true,
      "should_fail_to_cast_if_test_fails": true
    },
    {
      "id": "VirodaemonologistSpendToxicity",
      "name": "@CardEffectRewardToxicity",
      "target_mode": "self",
      "param_int": -5,
      "should_test": true,
      "should_fail_to_cast_if_test_fails": true
    },
    {
      "id": "VirodaemonologistPermaStats",
      "name": "CardEffectAddCardUpgradeToUnits",
      "target_mode": "self",
      "param_int_3": 2,
      "param_bool": true,
      "param_upgrade": "@ViroUpgrade"
    }  
  ],
  "upgrades": [
    {
        "id": "ViroUpgrade",
        "bonus_damage": 10,
        "bonus_hp": 5,
        "upgrade_will_be_scaled_by_non_magic_power_trait": true
    }
  ],
  "game_objects": [
    {
      "id": "VirodaemonologistUnitCardArt",
      "type": "card_art",
      "extensions": {
        "card_art": {
          "sprite": "@VirodaemonologistUnitCardSprite"
        }
      }
    },
    {
      "id": "VirodaemonologistUnitCharacterArt",
      "type": "character_art",
      "extensions": {
        "character_art": {
          "sprite": "@VirodaemonologistUnitCharacterSprite"
        }
      }
    }
  ],
  "sprites": [
    {
      "id": "VirodaemonologistUnitCardSprite",
      "path": "textures/card_art/VirodaemonologistCard.png"
    },
    {
      "id": "VirodaemonologistUnitCharacterSprite",
      "path": "textures/character_art/VirodaemonologistCharacter.png"
    }
  ]
}
