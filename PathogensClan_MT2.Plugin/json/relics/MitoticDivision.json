{
  "$schema": "https://github.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/releases/latest/download/schema.json",
  "relics": [
    {
      "id": "MitoticDivision",
      "type": "collectable",
      "names": {
        "english": "Mitotic Division",
        "chinese": ""
      },
      "descriptions": {
        "english": "When you summon your first unit each turn, add a 0[ember] <b>Virion</b> spell with [ephemeral] to your hand.",
        "chinese": ""
      },
      "lore_tooltips": [
        {
          "english": ".",
          "chinese": ""
        }
      ],
      "lore_style": "herzal",
      "relic_effects": [ "@MitoticCard" ],
      "icon": "@MitoticDivisionArtifactIcon",
      "icon_small": "@MitoticDivisionArtifactSmallIcon",
      "extensions": [
        {
          "collectable": {
            "class": "@ClassPathogens",
            "pools": ["MegaRelicPool" ],
            "rarity": "common"
          }
        }
      ]
    }
  ],
  "relic_effects": [
    {
      "id": "MitoticCard",
      "name": "RelicEffectAddBattleCardToHand",
      "param_card_pool": "@VirionPool",
      "param_upgrade": "MitoticUpgrades",
      
      "conditions": ["@MitoticConditions"],
    }
  ],
  "relic_effect_conditions": [
    {
      "id": "MitoticConditions",
      "param_card_type": "monster",
      "param_tracked_value": "any_card_played",
      "param_entry_duration": "this_turn",
      "param_comparator": [
        "greater_than",
        "equal"
      ],
      "param_int": 1,
      "allow_multiple_triggers_per_duration": false
    }
  ],
  "upgrades": [
  {
    "id": "MitoticUpgrades",
    "cost_reduction": 99,
    "trait_upgrades": [
      {
       "id": "@PathogensEphemeral"
      }
    ]
  }
  ],
  "sprites": [
    {
      "id": "MitoticDivisionArtifactIcon",
      "path": "textures/relic_art/MitoticDivisionArtifact.png"
    },
    {
      "id": "MitoticDivisionArtifactSmallIcon",
      "path": "textures/relic_art/MitoticDivisionHUD.png"
    }
  ]
}
