        "equal"
      ],
      "param_int": 2,
      "allow_multiple_triggers_per_duration": true
    }
  ],
  "sprites": [
    {
      "id": "BottledTerrariumArtifactIcon",
      "path": "textures/relic_art/GrowthChamberArtifact.png"
