{
  "$schema": "https://github.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/releases/latest/download/schema.json",
  "relics": [
    {
      "id": "BottledTerrarium",
      "type": "collectable",
      "names": {
        "english": "Bottled Terrarium",
        "chinese": ""
      },
      "descriptions": {
        "english": "Every 2 units you summon this battle, all cards gain +[effect0.power] [magicpower] for the rest of this battle.",
        "chinese": ""
      },
      "lore_tooltips": [
        {
          "english": ".",
          "chinese": ""
        }
      ],
      "lore_style": "herzal",
